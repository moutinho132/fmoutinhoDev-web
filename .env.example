# YouTube API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 in your Google Cloud Console
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your YouTube Channel ID
# Find your channel ID at: https://www.youtube.com/account_advanced
YOUTUBE_CHANNEL_ID=your_channel_id_here

# Meta Pixel ID (for Facebook/Instagram tracking)
NEXT_PUBLIC_META_PIXEL_ID=your_pixel_id_here

# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=your_ga_measurement_id_here

# Site URL (for payment callbacks)
NEXT_PUBLIC_SITE_URL=https://fmoutinho-dev-web.vercel.app

# ====================
# PAYMENT CONFIGURATION
# ====================

# PayPal Configuration
# Get credentials from: https://developer.paypal.com/
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox  # Use 'live' for production

# Stripe Configuration
# Get credentials from: https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Binance Pay Configuration
# Get credentials from: https://www.binance.com/en/support/faq/how-to-set-up-binance-pay-api-keys-360040337571
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
