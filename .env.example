# YouTube API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 in your Google Cloud Console
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your YouTube Channel ID
# Find your channel ID at: https://www.youtube.com/account_advanced
YOUTUBE_CHANNEL_ID=your_channel_id_here

# Meta Pixel ID (for Facebook/Instagram tracking)
NEXT_PUBLIC_META_PIXEL_ID=your_pixel_id_here

# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=your_ga_measurement_id_here
